# Copy this file to .env and fill it in.

# Claude API key from https://platform.claude.com (Settings → API keys)
ANTHROPIC_API_KEY=

# Your business (the agent uses these in replies)
BUSINESS_NAME=Your Tent & Event Rentals
OWNER_NAME=Sam
SERVICE_AREA=Central New Jersey
# Anything the agent should know. Keep it to facts, it won't quote prices.
BUSINESS_NOTES=Delivery within 40 miles. We need at least 2 weeks' notice for tents over 40x40. Tents over 400 sq ft may need a town permit; we can help with that.

# Which emails to check (Gmail search syntax) and how often, in seconds
GMAIL_QUERY=in:inbox newer_than:3d -category:promotions -category:social -category:updates
POLL_SECONDS=120

# Set a password if the dashboard will be reachable by anyone else
DASHBOARD_PASSWORD=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# PORT=5000
